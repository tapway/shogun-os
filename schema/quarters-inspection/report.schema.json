{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarters Inspection Report",
  "description": "Structured report produced from VLM assessment of staff quarters photos",
  "type": "object",
  "required": ["pack_id", "unit_id", "inspected_at", "submitter", "inventory_results", "checklist_results", "failed_items", "overall_status"],
  "properties": {
    "pack_id": { "type": "string", "description": "Pack identifier used for this inspection" },
    "site_id": { "type": "string", "description": "Site/estate identifier" },
    "unit_id": { "type": "string", "description": "Unit identifier, e.g. Block-A-12" },
    "inspected_at": { "type": "string", "description": "ISO 8601 datetime" },
    "submitter": { "type": "string", "description": "Submitter identifier, e.g. telegram:12345" },
    "media_count": { "type": "integer", "minimum": 0 },
    "inventory_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expected", "observed", "status"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "expected": { "type": "integer", "minimum": 0 },
          "observed": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "notes": { "type": "string" }
        }
      }
    },
    "checklist_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "notes": { "type": "string" }
        }
      }
    },
    "cleanliness_summary": { "type": "string" },
    "site_condition_summary": { "type": "string" },
    "failed_items": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of all failed inventory + checklist items"
    },
    "overall_status": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "pass iff no fail in inventory_results or checklist_results (missing required inventory = fail)"
    },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "model_notes": { "type": "string" }
  }
}
